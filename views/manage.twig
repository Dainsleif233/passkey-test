{% extends 'user.base' %}

{% block title %}{{ trans('SysHub\\Passkey::messages.manage.title') }}{% endblock %}

{% block content %}
<div id="passkey-manage-app">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ trans('SysHub\\Passkey::messages.manage.title') }}</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-primary btn-sm" id="passkey-add-btn">
                    <i class="fa fa-plus"></i> {{ trans('SysHub\\Passkey::messages.manage.add') }}
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="passkey-alert" class="alert" style="display:none; margin: 1rem;"></div>
            
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>{{ trans('SysHub\\Passkey::messages.manage.name') }}</th>
                        <th>{{ trans('SysHub\\Passkey::messages.manage.created_at') }}</th>
                        <th>{{ trans('SysHub\\Passkey::messages.manage.last_used_at') }}</th>
                        <th>{{ trans('SysHub\\Passkey::messages.manage.actions') }}</th>
                    </tr>
                </thead>
                <tbody id="passkey-list">
                    <tr id="passkey-loading">
                        <td colspan="4" class="text-center">
                            <i class="fa fa-spinner fa-spin"></i> {{ trans('SysHub\\Passkey::messages.manage.loading') }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create/Rename Modal -->
<div class="modal fade" id="passkey-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passkey-modal-title">{{ trans('SysHub\\Passkey::messages.manage.enter_name') }}</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="passkey-name-input">{{ trans('SysHub\\Passkey::messages.manage.name') }}</label>
                    <input type="text" class="form-control" id="passkey-name-input" maxlength="50" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">{{ trans('SysHub\\Passkey::messages.manage.cancel') }}</button>
                <button type="button" class="btn btn-primary" id="passkey-modal-confirm">{{ trans('SysHub\\Passkey::messages.manage.confirm') }}</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal fade" id="passkey-delete-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ trans('SysHub\\Passkey::messages.manage.confirm_delete') }}</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>{{ trans('SysHub\\Passkey::messages.manage.delete_warning') }}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">{{ trans('SysHub\\Passkey::messages.manage.cancel') }}</button>
                <button type="button" class="btn btn-danger" id="passkey-delete-confirm">{{ trans('SysHub\\Passkey::messages.manage.delete') }}</button>
            </div>
        </div>
    </div>
</div>

<script id="passkey-config" type="application/json">
{{ {
    urls: {
        list: url('user/passkey'),
        create: url('user/passkey'),
        createOptions: url('user/passkey/create-options'),
        rename: url('user/passkey') ~ '/',
        delete: url('user/passkey') ~ '/'
    },
    messages: {
        creating: trans('SysHub\\Passkey::messages.manage.creating'),
        success: trans('SysHub\\Passkey::messages.manage.success'),
        error: trans('SysHub\\Passkey::messages.manage.error'),
        confirmDelete: trans('SysHub\\Passkey::messages.manage.confirm_delete'),
        enterName: trans('SysHub\\Passkey::messages.manage.enter_name'),
        never: trans('SysHub\\Passkey::messages.manage.never'),
        empty: trans('SysHub\\Passkey::messages.manage.empty'),
        noResult: trans('SysHub\\Passkey::messages.manage.no_result')
    }
}|json_encode|raw }}
</script>
{% endblock %}
